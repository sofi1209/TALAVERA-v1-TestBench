	(text "MCU1 is drawn as the ESP32-WROOM-32D module so the GPIO names are readable."
		(exclude_from_sim no)
		(at 205.0000 300.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "f014252a-67af-40af-a561-9ac4398a8480")
	)
	(text "The PHYSICAL part is a socketed ESP32-DevKitC V4 on 2 x PPTC191LFBN-RC (D-042),"
		(exclude_from_sim no)
		(at 205.0000 304.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "41a53ab2-e3cc-44a6-b9b4-8090e12117ab")
	)
	(text "so the symbol-to-socket pin mapping is set when the DevKitC footprint is made (O-16)."
		(exclude_from_sim no)
		(at 205.0000 308.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "f086ddcd-cb09-4520-91f9-fd07913d3365")
	)
	(text "Pins avoid GPIO6-11 (SPI flash) and all strapping pins 0, 2, 5, 12, 15 (D-031)."
		(exclude_from_sim no)
		(at 205.0000 312.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "9e36631e-46d7-4e93-af8f-efd8b840f714")
	)
	(text "RECORD sits on IO34 because 34-39 are INPUT-ONLY and cannot become outputs."
		(exclude_from_sim no)
		(at 205.0000 316.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "220b2bff-3bf7-43bd-8395-3a9aa85c4b54")
	)
