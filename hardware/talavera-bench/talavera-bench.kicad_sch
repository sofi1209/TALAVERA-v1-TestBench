		(uuid "5bc3d2a9-27ed-43ec-9dea-eaa4f104e1d9")
	)
	(text "The PHYSICAL part is a socketed ESP32-DevKitC V4 on 2 x PPTC191LFBN-RC (D-042),"
		(exclude_from_sim no)
		(at 205.0000 304.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "7a0c93de-3899-45f0-ba2a-5e434ac34fd2")
	)
	(text "so the symbol-to-socket pin mapping is set when the DevKitC footprint is made (O-16)."
		(exclude_from_sim no)
		(at 205.0000 308.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "3a53597c-2551-443f-8199-5555c5b16e8b")
	)
	(text "Pins avoid GPIO6-11 (SPI flash) and all strapping pins 0, 2, 5, 12, 15 (D-031)."
		(exclude_from_sim no)
		(at 205.0000 312.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "e66d08db-9a4a-4835-946b-a6f15246a844")
	)
	(text "RECORD sits on IO34 because 34-39 are INPUT-ONLY and cannot become outputs."
		(exclude_from_sim no)
		(at 205.0000 316.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "b491ed99-3f06-4274-9e85-1b6faf714b76")
	)
	(text "6. STORAGE - on-board microSD"
