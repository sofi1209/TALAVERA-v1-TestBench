	(text "MCU1 is drawn as the ESP32-WROOM-32D module so the GPIO names are readable."
		(exclude_from_sim no)
		(at 282.9000 414.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
