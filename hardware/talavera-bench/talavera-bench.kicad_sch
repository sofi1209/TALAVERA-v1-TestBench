		(at 282.9000 436.0800 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "dc0f15d2-6adc-4351-bee7-6966cccda796")
	)
