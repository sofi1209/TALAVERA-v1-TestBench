	(text "MCU1 is drawn as the ESP32-WROOM-32D module so the GPIO names are readable."
		(exclude_from_sim no)
		(at 205.0000 300.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "7cfbbf1a-4473-473c-9ba9-12f092027385")
	)
	(text "The PHYSICAL part is a socketed ESP32-DevKitC V4 on 2 x PPTC191LFBN-RC (D-042),"
		(exclude_from_sim no)
		(at 205.0000 304.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "a0014f63-9ea9-47aa-aa6f-eba3c127375a")
	)
	(text "so the symbol-to-socket pin mapping is set when the DevKitC footprint is made (O-16)."
		(exclude_from_sim no)
		(at 205.0000 308.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "f62fdb49-1e20-48ad-9dbd-2e728e0c2699")
	)
	(text "Pins avoid GPIO6-11 (SPI flash) and all strapping pins 0, 2, 5, 12, 15 (D-031)."
		(exclude_from_sim no)
		(at 205.0000 312.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "463385f1-c5c1-4fba-9b57-ab8fa8eefaeb")
	)
	(text "RECORD sits on IO34 because 34-39 are INPUT-ONLY and cannot become outputs."
		(exclude_from_sim no)
		(at 205.0000 316.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "9c459388-40f7-4180-bffa-97ddf418577d")
	)
