	(text "MCU1 is drawn as the ESP32-WROOM-32D module so the GPIO names are readable."
		(exclude_from_sim no)
		(at 282.9000 414.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "b4365d25-350c-46b2-aa4a-ae0b7f837030")
	)
	(text "The PHYSICAL part is a socketed ESP32-DevKitC V4 on 2 x PPTC191LFBN-RC (D-042),"
		(exclude_from_sim no)
		(at 282.9000 419.5200 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "69729d2a-1483-4c93-b8f1-9ef24bdce24d")
	)
	(text "so the symbol-to-socket pin mapping is set when the DevKitC footprint is made (O-16)."
		(exclude_from_sim no)
		(at 282.9000 425.0400 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "3b2862b8-f118-41c4-bb33-cb0604974c73")
	)
	(text "Pins avoid GPIO6-11 (SPI flash) and all strapping pins 0, 2, 5, 12, 15 (D-031)."
		(exclude_from_sim no)
		(at 282.9000 430.5600 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "b32e113e-7071-43f6-bdc4-8ccb895c6c0d")
	)
	(text "RECORD sits on IO34 because 34-39 are INPUT-ONLY and cannot become outputs."
		(exclude_from_sim no)
		(at 282.9000 436.0800 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "02b288dd-d118-4b55-9eb3-0be8a0f8a5d7")
	)
