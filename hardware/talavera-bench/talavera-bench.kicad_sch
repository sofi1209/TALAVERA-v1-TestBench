			)
			(justify left top)
		)
		(uuid "e8e75309-c3ea-4e18-842c-4103ee7ec176")
	)
	(text "The PHYSICAL part is a socketed ESP32-DevKitC V4 on 2 x PPTC191LFBN-RC (D-042),"
		(exclude_from_sim no)
		(at 282.9000 419.5200 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "8685a6fb-4098-45a4-ae91-aa80ca3d84e0")
	)
	(text "so the symbol-to-socket pin mapping is set when the DevKitC footprint is made (O-16)."
		(exclude_from_sim no)
		(at 282.9000 425.0400 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "c9d62eac-f794-4d52-b43c-8c7bdb05f27b")
	)
	(text "Pins avoid GPIO6-11 (SPI flash) and all strapping pins 0, 2, 5, 12, 15 (D-031)."
		(exclude_from_sim no)
		(at 282.9000 430.5600 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
