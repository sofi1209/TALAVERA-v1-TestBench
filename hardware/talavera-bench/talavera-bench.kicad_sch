	(text "MCU1 is drawn as the ESP32-WROOM-32D module so the GPIO names are readable."
		(exclude_from_sim no)
		(at 205.0000 300.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "7583398c-6c63-4771-b40b-3bd117d781de")
	)
	(text "The PHYSICAL part is a socketed ESP32-DevKitC V4 on 2 x PPTC191LFBN-RC (D-042),"
		(exclude_from_sim no)
		(at 205.0000 304.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "07441680-2f72-45a7-95e5-d33c80cb716c")
	)
	(text "so the symbol-to-socket pin mapping is set when the DevKitC footprint is made (O-16)."
		(exclude_from_sim no)
		(at 205.0000 308.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "7559b249-e1f3-43a9-a916-e73741cfb01d")
	)
	(text "Pins avoid GPIO6-11 (SPI flash) and all strapping pins 0, 2, 5, 12, 15 (D-031)."
		(exclude_from_sim no)
		(at 205.0000 312.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "39ce21d6-146d-4d4a-acf5-0ceba3153d56")
	)
	(text "RECORD sits on IO34 because 34-39 are INPUT-ONLY and cannot become outputs."
		(exclude_from_sim no)
		(at 205.0000 316.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "22835805-7f68-4854-905f-6487958e340f")
	)
