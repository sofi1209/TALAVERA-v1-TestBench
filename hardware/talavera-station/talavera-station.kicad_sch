	)
	(text "O-21 OPEN, NOT FIXED HERE: this RX path INVERTS.\nLED conducts on RO HIGH and an enabled 6N137 pulls its\noutput LOW, so an idle mark reaches the CH340C as a\ncontinuous break. Telemetry cannot work as drawn. The fix\nis a part change, not a rewire - see REV-A1-CHANGES."
		(exclude_from_sim no)
		(at 205.0000 242.0000 0)
		(effects
			(font
				(size 1.40 1.40)
				(thickness 0.21)
				(bold no)
			)
			(justify left top)
		)
		(uuid "93f73ea8-4a08-4528-ace7-178f03165118")
	)
